# 1. API Key de Google Gemini (Gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# 2. URL del Webhook de tu Google Sheet (obtenida tras implementar google_apps_script.js)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec

# 3. Token del Bot de Telegram (Obtenido en 30 segundos con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui

# 4. (Opcional - solo si usas WhatsApp Cloud API)
WHATSAPP_TOKEN=tu_token_permanente_meta
WHATSAPP_PHONE_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=siniestros_secret_token_123
PORT=5000
